# ==========================================
# REQUIRED PRODUCTION SECRETS (Fail-Fast in Production)
# ==========================================
# Secret key used for signing & verifying JWT authentication tokens
JWT_SECRET=your_production_jwt_secret_here

# Supabase URL & Service Role / Anon Key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_api_key_here

# ==========================================
# OPTIONAL PLATFORM INTEGRATION CREDENTIALS
# ==========================================

# Meta / Facebook & Instagram
FB_APP_ID=
FB_APP_SECRET=
FB_REDIRECT_URI=http://localhost:5000/api/auth/facebook/callback
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/auth/instagram/callback

# TikTok (Login Kit / Content Posting API v2)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:5000/api/auth/tiktok/callback

# Twitter / X (OAuth 2.0 PKCE)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:5000/api/auth/twitter/callback

# Google / YouTube (OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/auth/youtube/callback

# Pinterest
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:5000/api/auth/pinterest/callback

# Cloudinary (Media Assets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis & Queues
REDIS_URL=redis://127.0.0.1:6379
SCHEDULED_POSTS_QUEUE_ENABLED=false
ANALYTICS_QUEUE_ENABLED=false
SCHEDULED_POSTS_RECOVERY_ENABLED=true
SCHEDULED_POSTS_RECOVERY_PATTERN=*/15 * * * *
SCHEDULED_POSTS_BATCH_SIZE=10
SCHEDULED_POSTS_QUEUE_ATTEMPTS=3
SCHEDULED_POSTS_QUEUE_BACKOFF_DELAY_MS=30000
SCHEDULED_POSTS_QUEUE_CONCURRENCY=5
